# Copy to .env and fill ONLY the provider you use. All of these have a free tier / free usage.

# --- Option A: Groq (free API key: https://console.groq.com/keys) ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# --- Option B: Google Gemini (free API key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Option C: OpenRouter (free models ending in ":free") ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Option D: Ollama (local, no key). Install from https://ollama.com then: ollama pull llama3.2:3b ---
# OLLAMA_MODEL=llama3.2:3b

# Free tiers are rate-limited: wait N seconds between calls if you get HTTP 429
REQUEST_DELAY=0

# Reference price used to compute an EQUIVALENT cost (USD per 1M tokens).
# Defaults = gpt-4o-mini list price. Edit to compare against any paid model.
PRICE_INPUT_PER_1M=0.15
PRICE_OUTPUT_PER_1M=0.60
